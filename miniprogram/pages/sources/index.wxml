<view class="page-shell">
  <app-header title="智深专属知识库" subtitle="原资料全生命周期管理" online="{{online}}" />
  <view class="page-content">
    <view class="hero">
      <view><view><text class="section-title">原资料文件操作台</text><text class="hero__count">{{groups.length}} 个文件</text></view><text class="section-note">查看、摄入、检索与删除知识来源</text></view>
      <button class="primary-button hero__button" bindtap="openIngest">⇧ 上传/导入</button>
    </view>

    <input class="field search" value="{{query}}" placeholder="搜索文档名或内容摘要..." bindinput="onSearch" />
    <picker range="{{sourceOptions}}" value="{{sourceIndex}}" bindchange="onSourceChange">
      <view class="field picker">▧ {{sourceOptions[sourceIndex]}} <text>⌄</text></view>
    </picker>

    <state-view wx:if="{{loading}}" type="loading" title="正在读取原资料" />
    <state-view wx:elif="{{error}}" type="error" title="读取失败" message="{{error}}" action-text="重新加载" bind:action="refresh" />
    <state-view wx:elif="{{!visibleGroups.length}}" title="没有匹配的资料" message="可以导入服务端已有的文件或目录。" action-text="上传/导入" bind:action="openIngest" />

    <view wx:else class="sources">
      <view wx:for="{{visibleGroups}}" wx:key="source" class="card source-card">
        <view class="source-card__head">
          <view class="file-icon">{{item.fileType}}</view>
          <view class="source-card__title"><text>{{item.displayName}}</text><text>{{item.sizeLabel}} · 已切块就绪</text></view>
          <view class="source-card__tools">
            <button data-source="{{item.source}}" bindtap="unavailable">↻</button>
            <button data-source="{{item.source}}" bindtap="unavailable">⌁</button>
            <button data-source="{{item.source}}" bindtap="remove">♲</button>
          </view>
        </view>
        <text class="source-card__preview">{{item.preview}}</text>
        <view class="source-card__meta"><text>◎ {{item.count}} 切块</text><text>◇ {{item.sizeLabel}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{ingestOpen}}" class="modal" bindtap="closeIngest">
    <view class="modal__sheet" catchtap="stopTap">
      <view class="modal__head"><text>导入服务端资料</text><button bindtap="closeIngest">×</button></view>
      <text class="modal__note">输入 Go 网关进程能够访问的文件或目录路径。</text>
      <input class="field" value="{{ingestPath}}" placeholder="./docs" bindinput="onPathInput" />
      <view class="modal__tips"><text>• 支持单个文件或整个目录</text><text>• 再次导入同来源会覆盖原有片段</text><text>• 真机不能直接上传本地文件</text></view>
      <button class="primary-button" disabled="{{ingesting || !ingestPath}}" loading="{{ingesting}}" bindtap="ingest">{{ingesting ? '正在入库…' : '开始摄入'}}</button>
    </view>
  </view>

  <bottom-nav current="sources" />
</view>
