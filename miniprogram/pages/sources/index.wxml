<view class="page-shell">
  <app-header title="智深专属知识库" subtitle="原资料全生命周期管理" online="{{online}}" />
  <view class="page-content">
    <view class="hero"><view><view><text class="section-title">原资料文件操作台</text><text class="hero__count">{{documents.length}} 个文件</text></view><text class="section-note">支持原文件查看、在线内容修改、重命名、重新分块与删除</text></view><button class="primary-button hero__button" bindtap="chooseUpload">⇧ 上传/导入</button></view>
    <view class="filters"><input class="field search" value="{{query}}" placeholder="搜索文档名、标签或内容摘要..." bindinput="onSearch" /><picker range="{{libraryOptions}}" range-key="name" value="{{libraryIndex}}" bindchange="onLibraryChange"><view class="field picker">📁 {{libraryOptions[libraryIndex].name}}⌄</view></picker></view>

    <state-view wx:if="{{loading}}" type="loading" title="正在读取原资料" />
    <state-view wx:elif="{{error}}" type="error" title="读取失败" message="{{error}}" action-text="重新加载" bind:action="refresh" />
    <state-view wx:elif="{{!visibleDocuments.length}}" title="暂无匹配资料" message="上传 PDF、DOCX、PPTX、Markdown、TXT、HTML 或 CSV。" />

    <view wx:else class="documents">
      <view wx:for="{{visibleDocuments}}" wx:key="id" class="card document">
        <view class="document__head"><view class="file-icon">{{item.formatLabel}}</view><view><text>{{item.display_name}}</text><view><text>{{item.sizeLabel}}</text><text class="status {{item.status}}">{{item.statusLabel}}</text><text wx:if="{{item.readOnly}}" class="readonly">公开只读</text></view></view></view>
        <text class="document__summary">{{item.summary || '索引完成后将在这里生成内容摘要。'}}</text>
        <view class="document__library"><text>所属知识库：</text><text>{{item.libraryName}}</text><text wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text></view>
        <view wx:if="{{!item.readOnly}}" class="document__actions"><button data-id="{{item.id}}" disabled="{{workingID === item.id}}" bindtap="reindex">重新切块向量化</button><button data-id="{{item.id}}" disabled="{{workingID === item.id}}" bindtap="openEditor">在线编辑/重命名</button><button class="danger" data-id="{{item.id}}" data-name="{{item.display_name}}" bindtap="remove">删除</button></view>
        <view class="document__meta"><text>{{item.chunk_count}} 切块</text><text>·</text><text>{{item.tokenLabel}} Tokens</text><text>更新于 {{item.updatedLabel}}</text></view>
      </view>
    </view>
  </view>
  <document-editor open="{{editorOpen}}" saving="{{editorSaving}}" document="{{editingDocument}}" content="{{editingContent}}" bind:close="closeEditor" bind:submit="saveEditor" />
  <bottom-nav current="sources" />
</view>
