.hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }.hero > view > view { display: flex; align-items: center; gap: 12rpx; }.hero__count { padding: 6rpx 14rpx; border-radius: 99rpx; color: #238f7d; background: #e5f6f2; font-size: 20rpx; }.hero__button { width: 190rpx; height: 76rpx; padding: 0 14rpx; font-size: 22rpx; }
.filters { display: grid; grid-template-columns: 1fr; gap: 12rpx; margin-top: 24rpx; }.search { padding-left: 24rpx; }.picker { overflow: hidden; color: #5f6d7b; font-size: 23rpx; line-height: 84rpx; text-overflow: ellipsis; white-space: nowrap; }
.documents { display: grid; gap: 18rpx; margin-top: 24rpx; }.document { padding: 24rpx; }.document__head { display: flex; align-items: center; gap: 16rpx; }.file-icon { display: grid; flex: 0 0 auto; width: 68rpx; height: 68rpx; place-items: center; border-radius: 20rpx; color: #fff; background: linear-gradient(145deg,#34455f,#172238); font-size: 18rpx; font-weight: 700; }.document__head > view:last-child { min-width: 0; }.document__head > view:last-child > text { display: block; overflow: hidden; color: #172238; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.document__head > view:last-child > view { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; color: #929ca7; font-size: 19rpx; }
.status,.readonly { padding: 5rpx 10rpx; border-radius: 99rpx; color: #238f7d; background: #e8f8f4; }.status.failed,.status.delete_failed { color: #d54e60; background: #fff0f2; }.status.queued,.status.processing { color: #9b6d15; background: #fff7df; }.readonly { color: #7350b2; background: #f1eaff; }
.document__summary { display: -webkit-box; margin-top: 17rpx; overflow: hidden; color: #687685; font-size: 22rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.document__library { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 15rpx; color: #86919d; font-size: 20rpx; }.document__library text:nth-child(n+3) { color: #218f7c; }
.document__actions { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #edf0f2; }.document__actions button { height: 62rpx; padding: 0 14rpx; border-radius: 18rpx; color: #516071; background: #f3f6f6; font-size: 19rpx; line-height: 62rpx; }.document__actions button:nth-child(2) { color: #168877; background: #e8f8f4; }.document__actions .danger { color: #d65061; background: #fff1f3; }
.document__meta { display: flex; flex-wrap: wrap; gap: 8rpx 14rpx; margin-top: 16rpx; color: #98a1ab; font-size: 18rpx; }.document__meta text:last-child { margin-left: auto; }
