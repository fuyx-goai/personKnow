.profile-page { background: linear-gradient(180deg,#eaf7f4 0,#f5f7f8 320rpx); }.sheet { padding: 28rpx; }.sheet__title { display: flex; align-items: center; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 1rpx solid #e9edef; color: #172238; font-size: 27rpx; font-weight: 700; }
.identity { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 22rpx; border: 1rpx solid #d9eee9; border-radius: 25rpx; background: linear-gradient(135deg,#f1fbf8,#e9f8f4); }.avatar { display: grid; flex: 0 0 auto; width: 84rpx; height: 84rpx; place-items: center; border: 5rpx solid #2ba58f; border-radius: 25rpx; color: #fff; background: linear-gradient(145deg,#50627b,#172238); font-size: 34rpx; font-weight: 700; }.identity > view:last-child { min-width: 0; }.identity text { display: block; }.identity > view:last-child > text:first-child { color: #152137; font-size: 27rpx; font-weight: 700; }.identity > view:last-child > text:nth-child(2) { overflow: hidden; margin-top: 3rpx; color: #8793a0; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.identity .identity__role { margin-top: 7rpx; color: #6f7d8a; font-size: 20rpx; }.identity__role text { display: inline; color: #218f7c; }
.tabs { display: grid; grid-template-columns: repeat(3,1fr); margin: 24rpx 0; padding: 6rpx; border-radius: 19rpx; background: #f0f3f5; }.tabs button { height: 62rpx; padding: 0; border-radius: 16rpx; color: #778290; background: transparent; font-size: 21rpx; line-height: 62rpx; }.tabs button.is-active { color: #243147; background: #fff; box-shadow: 0 4rpx 12rpx rgba(20,35,48,.08); font-weight: 600; }.error-card { padding: 18rpx; border-radius: 18rpx; color: #d6485b; background: #fff0f2; font-size: 21rpx; }
.usage-card { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #e6eaed; border-radius: 22rpx; background: #fafbfc; }.usage-card > view:first-child { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; color: #687584; font-size: 22rpx; }.usage-card > view:first-child text:last-child { color: #172238; font-size: 23rpx; font-weight: 700; }.usage-card > text { display: block; margin-top: 11rpx; color: #8b96a3; font-size: 19rpx; }.progress { height: 13rpx; margin-top: 17rpx; border-radius: 99rpx; background: #e8ecef; overflow: hidden; }.progress > view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#42bba5,#2ba58f); }.progress.token > view { background: linear-gradient(90deg,#6f8fe8,#8c62df); }
.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 16rpx; }.summary view { padding: 22rpx; border: 1rpx solid #e6eaed; border-radius: 22rpx; background: #fff; text-align: center; }.summary text { display: block; }.summary text:first-child { color: #172238; font-size: 33rpx; font-weight: 700; }.summary text:last-child { margin-top: 5rpx; color: #8b96a3; font-size: 20rpx; }
.audit { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e8ecef; }.subhead { display: flex; justify-content: space-between; color: #253146; font-size: 23rpx; font-weight: 700; }.subhead text:last-child { color: #99a2ac; font-size: 19rpx; font-weight: 400; }.audit-row { display: grid; grid-template-columns: 14rpx 1fr auto; align-items: center; gap: 12rpx; padding: 15rpx 0; border-bottom: 1rpx solid #f0f2f3; }.audit-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #2ba58f; }.audit-row text { display: block; }.audit-row > view text:first-child { color: #455365; font-size: 20rpx; }.audit-row > view text:last-child,.audit-row > text { margin-top: 3rpx; color: #9ba4ae; font-size: 16rpx; }
.field-label { display: block; margin: 20rpx 0 9rpx; color: #5b6876; font-size: 21rpx; font-weight: 600; }.select-field { height: 76rpx; padding: 0 20rpx; border: 1rpx solid #e1e7e8; border-radius: 19rpx; color: #263247; background: #fafbfc; font-size: 22rpx; line-height: 76rpx; }.range-head { display: flex; justify-content: space-between; margin-top: 25rpx; color: #596675; font-size: 21rpx; }.range-head text:last-child { color: #218f7c; font-weight: 700; }.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 20rpx; border-radius: 20rpx; background: #f7f9f9; }.switch-row text { display: block; }.switch-row text:first-child { color: #344154; font-size: 22rpx; font-weight: 600; }.switch-row text:last-child { margin-top: 5rpx; color: #929ca7; font-size: 18rpx; }.save { width: 100%; margin-top: 22rpx; }
.trusted { display: flex; gap: 16rpx; padding: 22rpx; border: 1rpx solid #d9eee9; border-radius: 23rpx; background: #f1fbf8; }.trusted > view:first-child { display: grid; flex: 0 0 auto; width: 50rpx; height: 50rpx; place-items: center; border-radius: 16rpx; color: #fff; background: #2ba58f; }.trusted text { display: block; }.trusted text:first-child { color: #244137; font-size: 22rpx; font-weight: 700; }.trusted text:last-child { margin-top: 6rpx; color: #6f827b; font-size: 19rpx; line-height: 1.5; }.session-row { display: flex; justify-content: space-between; gap: 14rpx; padding: 17rpx 4rpx; border-bottom: 1rpx solid #edf0f2; }.session-row text { display: block; }.session-row > view text:first-child { color: #455365; font-size: 21rpx; }.session-row > view text:last-child { margin-top: 4rpx; color: #99a2ac; font-size: 17rpx; }.session-row > text { color: #218f7c; font-size: 18rpx; }.backup-button { width: 100%; height: 76rpx; margin-top: 22rpx; border-radius: 21rpx; color: #168877; background: #e8f8f4; font-size: 22rpx; line-height: 76rpx; }
.logout-button { width: 100%; height: 76rpx; margin-top: 24rpx; border-radius: 21rpx; color: #d34f60; background: #fff2f4; font-size: 23rpx; line-height: 76rpx; }.empty-text { display: block; padding: 50rpx 0; color: #9aa3ad; text-align: center; }
