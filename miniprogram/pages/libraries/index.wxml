<view class="page-shell">
  <app-header title="智深专属知识库" subtitle="知识体系与来源分布" online="{{online}}" />
  <view class="page-content">
    <view class="hero">
      <view><view><text class="section-title">专属知识库</text><text class="hero__badge">{{totals.libraries}} 个体系</text></view><text class="section-note">高精度语义检索 · 私有与公开知识独立管理</text></view>
      <button class="primary-button hero__button" bindtap="openForm">＋ 新建</button>
    </view>

    <view class="stats">
      <view class="card stat"><text>▧</text><view><text class="stat__label">文档总量</text><text class="stat__value">{{totals.documents}}</text><text class="stat__label">份资料</text></view></view>
      <view class="card stat"><text>◎</text><view><text class="stat__label">总切块</text><text class="stat__value">{{totals.chunks}}</text><text class="stat__label">Chunks</text></view></view>
      <view class="card stat"><text>⌁</text><view><text class="stat__label">Embedding</text><text class="stat__value stat__word">Hybrid</text><text class="stat__label">混合检索</text></view></view>
    </view>

    <view class="filters">
      <input class="field search" value="{{query}}" placeholder="搜索知识库名称或描述..." bindinput="onSearch" />
      <picker range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="field picker">{{categoryOptions[categoryIndex]}}⌄</view></picker>
    </view>

    <state-view wx:if="{{loading}}" type="loading" title="正在读取知识体系" />
    <state-view wx:elif="{{error}}" type="error" title="读取失败" message="{{error}}" action-text="重新加载" bind:action="refresh" />
    <state-view wx:elif="{{!visibleLibraries.length}}" title="暂无知识库" message="创建第一个专属知识体系开始整理资料。" />

    <view wx:else class="libraries">
      <view wx:for="{{visibleLibraries}}" wx:key="id" class="card library {{item.accent}}">
        <view class="library__top">
          <view class="library__icon">⌘</view>
          <view class="library__title"><view><text>{{item.name}}</text><text class="pill {{item.readOnly ? 'is-public' : ''}}">{{item.readOnly ? '公开只读' : '私有'}}</text></view><text wx:if="{{item.readOnly}}">来自 {{item.ownerLabel}}</text><text wx:else>{{item.category || '未分类'}}</text></view>
        </view>
        <text class="library__desc">{{item.description || '已建立语义索引，可直接进入知识问答。'}}</text>
        <view class="library__meta"><text>▧ {{item.document_count}} 个文件</text><text>◇ {{item.sizeLabel}}</text><text>⌁ {{item.tokenLabel}} Tokens</text></view>
        <view class="library__actions">
          <button class="ghost-button" data-id="{{item.id}}" bindtap="manage">{{item.readOnly ? '查看资料' : '资料管理'}}</button>
          <button class="primary-button" data-id="{{item.id}}" bindtap="openChat">进入问答 ›</button>
        </view>
        <button wx:if="{{!item.readOnly}}" class="library__delete" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="remove">删除</button>
      </view>
    </view>
  </view>
  <library-form open="{{formOpen}}" saving="{{saving}}" bind:close="closeForm" bind:submit="createLibrary" />
  <bottom-nav current="libraries" />
</view>
