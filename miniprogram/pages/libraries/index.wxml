<view class="page-shell">
  <app-header title="智深专属知识库" subtitle="知识体系与来源分布" online="{{online}}" />
  <view class="page-content">
    <view class="hero">
      <view><view><text class="section-title">专属知识库</text><text class="hero__badge">{{groups.length}} 个体系</text></view><text class="section-note">高精度语义检索 · 来源隔离与原文件管理</text></view>
      <button class="primary-button hero__button" bindtap="unavailable">＋ 新建知识库</button>
    </view>

    <view class="stats">
      <view class="card stat"><text>▧</text><view><text class="stat__label">文档总量</text><text class="stat__value">{{groups.length}}</text><text class="stat__label">份来源</text></view></view>
      <view class="card stat"><text>◎</text><view><text class="stat__label">总切块</text><text class="stat__value">{{total}}</text><text class="stat__label">Chunks</text></view></view>
      <view class="card stat"><text>⌁</text><view><text class="stat__label">检索模式</text><text class="stat__value stat__word">Hybrid</text><text class="stat__label">语义优先</text></view></view>
    </view>

    <input class="field search" value="{{query}}" placeholder="搜索知识库名称或来源..." bindinput="onSearch" />

    <state-view wx:if="{{loading}}" type="loading" title="正在读取知识体系" />
    <state-view wx:elif="{{error}}" type="error" title="读取失败" message="{{error}}" action-text="重新加载" bind:action="refresh" />
    <state-view wx:elif="{{!visibleGroups.length}}" title="暂无知识来源" message="先到原资料操作页摄入文件或目录。" />

    <view wx:else class="libraries">
      <view wx:for="{{visibleGroups}}" wx:key="source" class="card library {{item.accent}}">
        <view class="library__top">
          <view class="library__icon">⌘</view>
          <view class="library__title"><text>{{item.name}}</text><text class="pill">私有</text></view>
        </view>
        <text class="library__desc">{{item.description}}</text>
        <view class="library__meta"><text>▧ {{item.count}} 个片段</text><text>◇ {{item.sizeLabel}}</text></view>
        <view class="library__actions">
          <button class="ghost-button" data-source="{{item.source}}" bindtap="manage">资料管理</button>
          <button class="primary-button" bindtap="openChat">进入问答 ›</button>
        </view>
      </view>
    </view>
  </view>
  <bottom-nav current="libraries" />
</view>
