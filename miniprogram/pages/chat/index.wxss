.chat-page { background: #f7f9f9; }.chat-toolbar { display: grid; grid-template-columns: 74rpx minmax(0,1fr) 76rpx; align-items: center; gap: 14rpx; padding: 22rpx 28rpx; border-bottom: 1rpx solid #e7ecee; background: #fff; }.history-button,.add-button { display: grid; width: 74rpx; height: 68rpx; padding: 0; place-items: center; border-radius: 22rpx; color: #54706c; background: #eff5f4; font-size: 25rpx; line-height: 1; }.history-button text { margin-left: 3rpx; font-size: 20rpx; }.add-button { color: #fff; background: #2ba58f; font-size: 36rpx; box-shadow: 0 8rpx 18rpx rgba(43,165,143,.2); }.library-picker { min-width: 0; }.library-picker__value { overflow: hidden; height: 68rpx; padding: 0 22rpx; border: 1rpx solid #dfe7e8; border-radius: 22rpx; color: #243146; background: #f7f9fa; font-size: 23rpx; font-weight: 600; line-height: 68rpx; text-overflow: ellipsis; white-space: nowrap; }
.messages { height: calc(100vh - 430rpx - env(safe-area-inset-bottom)); padding: 8rpx 28rpx 0; }.welcome { display: flex; flex-direction: column; align-items: center; padding-top: 70rpx; text-align: center; }.welcome__mark { display: grid; width: 86rpx; height: 86rpx; place-items: center; border-radius: 28rpx; color: #fff; background: #2ba58f; box-shadow: 0 14rpx 34rpx rgba(43,165,143,.22); font-size: 38rpx; }.welcome > text:nth-child(2) { margin-top: 22rpx; color: #152035; font-size: 35rpx; font-weight: 700; }.welcome > text:nth-child(3) { margin-top: 10rpx; color: #87929e; font-size: 22rpx; }.suggestions { display: grid; width: 100%; gap: 12rpx; padding: 34rpx 0 30rpx; text-align: left; }.suggestions > text { color: #9aa3ad; font-size: 22rpx; }.suggestions button { height: 72rpx; padding: 0 22rpx; border: 1rpx solid #e2e7ea; border-radius: 22rpx; color: #516071; background: #fff; font-size: 24rpx; line-height: 72rpx; text-align: left; }
.message { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 26rpx; }.message.user { flex-direction: row-reverse; }.user-avatar,.ai-avatar { display: grid; flex: 0 0 auto; width: 58rpx; height: 58rpx; place-items: center; border-radius: 19rpx; color: #fff; background: #10192d; font-size: 21rpx; font-weight: 700; }.ai-avatar { background: #2ba58f; box-shadow: 0 7rpx 16rpx rgba(43,165,143,.18); }.message__body { max-width: calc(100% - 78rpx); padding: 23rpx 25rpx; border: 1rpx solid #e1e7e8; border-radius: 28rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(25,45,50,.05); }.user .message__body { color: #fff; background: linear-gradient(135deg,#35ac98,#218f80); border-color: transparent; border-top-right-radius: 8rpx; box-shadow: 0 8rpx 18rpx rgba(43,165,143,.18); }.message__text { font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; }.typing { display: flex; gap: 8rpx; margin-top: 12rpx; }.typing > view { width: 8rpx; height: 8rpx; border-radius: 50%; background: #2ba58f; animation: bounce 1s infinite alternate; }.typing > view:nth-child(2) { animation-delay: .2s; }.typing > view:nth-child(3) { animation-delay: .4s; }
.references { display: grid; gap: 12rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f1; }.references__title { color: #2a9f8a; font-size: 22rpx; font-weight: 600; }.reference { padding: 16rpx; border: 1rpx solid #e1e8e9; border-radius: 18rpx; background: #f9fbfb; }.reference > view { display: flex; justify-content: space-between; gap: 14rpx; color: #263247; font-size: 22rpx; font-weight: 600; }.reference__score { flex: 0 0 auto; color: #2ba58f; font-size: 19rpx; }.reference__snippet { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #84909d; font-size: 20rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.reference__location { display: block; margin-top: 7rpx; color: #a0a8b1; font-size: 18rpx; }.model-meta { display: flex; justify-content: space-between; margin-top: 14rpx; color: #99a2ac; font-size: 18rpx; }
.chat-error { margin: 24rpx 0; padding: 18rpx 22rpx; border-radius: 18rpx; color: #d74659; background: #fff0f2; font-size: 22rpx; }.messages__spacer { height: 250rpx; }.composer { position: fixed; right: 24rpx; bottom: calc(126rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 25; padding: 20rpx 22rpx 15rpx; border: 1rpx solid #dfe5e7; border-radius: 30rpx; background: rgba(255,255,255,.98); box-shadow: 0 18rpx 50rpx rgba(20,40,48,.12); }.composer__input { width: 100%; min-height: 66rpx; max-height: 180rpx; color: #172238; font-size: 25rpx; line-height: 1.55; }.composer__bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; color: #8b97a3; font-size: 20rpx; }.composer__bottom > text { overflow: hidden; max-width: 540rpx; text-overflow: ellipsis; white-space: nowrap; }.send-button { display: grid; width: 70rpx; height: 70rpx; padding: 0; place-items: center; border-radius: 22rpx; color: #fff; background: #2ba58f; font-size: 30rpx; line-height: 1; }.send-button[disabled] { color: #bcc3c9; background: #edf0f2; }.send-button.stop { background: #10192d; }
.history-mask { position: fixed; inset: 0; z-index: 70; background: rgba(11,20,31,.44); backdrop-filter: blur(8rpx); }.history-panel { position: absolute; top: 0; bottom: 0; left: 0; width: 590rpx; padding: calc(44rpx + env(safe-area-inset-top)) 24rpx 30rpx; background: #fff; box-shadow: 16rpx 0 40rpx rgba(15,28,39,.16); }.history-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; color: #152035; font-size: 31rpx; font-weight: 700; }.history-head button { width: 56rpx; height: 56rpx; padding: 0; border-radius: 18rpx; color: #6d7884; background: #f1f4f5; line-height: 56rpx; }.history-row { width: 100%; height: auto; margin-top: 10rpx; padding: 18rpx 20rpx; border-radius: 19rpx; background: #f7f9f9; line-height: 1.4; text-align: left; }.history-row text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.history-row text:first-child { color: #263247; font-size: 23rpx; font-weight: 600; }.history-row text:last-child { margin-top: 5rpx; color: #99a2ac; font-size: 17rpx; }.history-empty { display: block; padding: 60rpx 0; color: #9aa3ad; text-align: center; }
@keyframes bounce { to { transform: translateY(-6rpx); opacity: .45; } }
