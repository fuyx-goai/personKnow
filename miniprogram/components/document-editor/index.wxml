<view wx:if="{{open}}" class="mask" bindtap="close">
  <view class="panel" catchtap="stopTap">
    <view class="panel__head"><view><text>{{readonly ? '查看原资料' : '在线编辑原资料'}}</text><text>{{readonly ? '来自问答引用，可返回继续查看回答' : '保存后自动生成新内容版本并重新索引'}}</text></view><button bindtap="close">×</button></view>
    <scroll-view class="panel__content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="form-row"><text>显示名称</text><input value="{{displayName}}" maxlength="255" disabled="{{readonly}}" bindinput="onName" /></view>
      <view class="form-row"><text>标签</text><input value="{{tags}}" placeholder="RAG，VectorDB，重排" disabled="{{readonly}}" bindinput="onTags" /></view>
      <view class="form-row"><text>{{readonly ? '资料正文' : '可编辑文本'}}</text><textarea class="content" value="{{text}}" maxlength="-1" disabled="{{readonly}}" cursor-spacing="24" bindinput="onText" /></view>
    </scroll-view>
    <view class="panel__footer">
      <button wx:if="{{readonly}}" class="submit secondary" bindtap="close">返回问答</button>
      <button wx:else class="submit" disabled="{{!displayName || !text || saving}}" bindtap="submit">{{saving ? '正在保存并重建索引…' : '保存修改'}}</button>
    </view>
  </view>
</view>
