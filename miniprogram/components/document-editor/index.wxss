.mask { position: fixed; inset: 0; z-index: 85; display: flex; align-items: flex-end; background: rgba(10,20,31,.52); backdrop-filter: blur(8rpx); }
.panel { display: flex; width: 100%; max-height: 92vh; padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 38rpx 38rpx 0 0; background: #fff; box-shadow: 0 -18rpx 54rpx rgba(12,29,42,.2); flex-direction: column; overflow: hidden; }
.panel__head { display: flex; flex: 0 0 auto; justify-content: space-between; gap: 20rpx; padding-bottom: 8rpx; }
.panel__head text { display: block; }
.panel__head text:first-child { color: #10192d; font-size: 33rpx; font-weight: 700; }
.panel__head text:last-child { margin-top: 6rpx; color: #8b96a2; font-size: 21rpx; }
.panel__head button { width: 58rpx; height: 58rpx; padding: 0; border-radius: 18rpx; color: #6c7785; background: #f1f4f5; font-size: 32rpx; line-height: 58rpx; }
.panel__content { min-height: 0; max-height: 66vh; flex: 1 1 auto; }
.form-row { margin-top: 18rpx; }
.form-row > text { display: block; margin-bottom: 9rpx; color: #5a6776; font-size: 22rpx; font-weight: 600; }
.form-row input, .form-row textarea { display: block; width: 100%; border: 1rpx solid #e2e8e9; border-radius: 20rpx; color: #172238; background: #f9fbfb; font-size: 24rpx; }
.form-row input { height: 76rpx; padding: 0 22rpx; line-height: 76rpx; }
.form-row textarea { padding: 20rpx 22rpx; }
.form-row input[disabled], .form-row textarea[disabled] { color: #344154; background: #f3f6f6; opacity: 1; }
.form-row .content { height: 430rpx; line-height: 1.7; overflow-y: auto; }
.panel__footer { flex: 0 0 auto; padding-top: 22rpx; background: #fff; }
.submit { width: 100%; height: 82rpx; margin: 0; border-radius: 23rpx; color: #fff; background: #2ba58f; font-size: 26rpx; font-weight: 700; line-height: 82rpx; }
.submit[disabled] { color: #aeb6bf; background: #e8ecef; }
.submit.secondary { color: #168877; border: 1rpx solid #b7ded6; background: #eff8f6; }
